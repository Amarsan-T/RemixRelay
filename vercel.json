{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/ai.py": {
      "excludeFiles": "{node_modules/**,src/**,convex/**,tests/**,experiments/**,backend/**,docs/**,dist/**,.git/**,.venv/**}",
      "maxDuration": 90
    }
  }
}
