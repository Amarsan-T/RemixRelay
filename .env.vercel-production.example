# Public build settings for the existing Convex project remixrelay.
# Owner-confirmed Production: silent-butterfly-873, US East (N. Virginia).
# Backend deployed from reviewed PR #7; website publication and demo seeding still need approval.
# Copy these three values into Vercel's Production environment after approval.
# Vite does not automatically load this filename. Do not rename it to .env.local.
# No deploy key or Claude API key belongs in this frontend configuration.
REMIXRELAY_DEPLOYMENT_MODE=collaborative-demo
REMIXRELAY_CONVEX_PRODUCTION_NAME=silent-butterfly-873
VITE_CONVEX_URL=https://silent-butterfly-873.convex.cloud
