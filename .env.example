# Safe local-only build / Vercel preview: no backend connection.
# Copy to .env.local for ordinary local development; Vercel settings are separate.
REMIXRELAY_DEPLOYMENT_MODE=local
VITE_CONVEX_URL=
REMIXRELAY_CONVEX_PRODUCTION_NAME=

